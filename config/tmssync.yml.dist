parameters:
  schema_file: '%kernel.project_dir%/schema.sql'
  source:
    table_prefix: 'dbo.'
    host: localhost
    driver: pdo_sqlsrv
    dbname: tms
    user: root
    password: root
    charset: UTF8
  destination:
    host: localhost
    driver: pdo_mysql
    dbname: tms
    user: root
    password: root
    charset: UTF8
  tables:
    - Objects
    - ObjContext
    - ObjectNames
    - ClassificationXRefs
    - Classifications
    - DimItemElemXrefs
    - Dimensions
    - DimensionElements
    - DimElemTypeXrefs
    - DimensionTypes
    - DimUnitTypes
    - DimensionUnits
    - DimensionMethods
    - DDLanguages
    - Constituents
    - ConAltNames
    - ConXrefs
    - ConXrefDetails
    - Roles
    - RoleTypes
    - TextTypes
    - TextEntries
    - TextStatuses
    - ThesXrefs
    - ThesXrefTypes
    - ThesaurusBases
    - TermClasses
    - TermMaster
    - Terms
    - UserFieldXrefs
    - ObjTitles
    - TitleTypes
    - CITvgsrpObjTombstoneD_RO
    - Departments
    - Associations
    - Relationships
    - AltNums
    - AltNumDescriptions
    - Locations
    - ObjLocations
    - ObjComponents
    - MediaXrefs
    - MediaRenditions
    - MediaFiles
    - ClassificationNotations
    - StatusFlags
    - AuthorityTranslations
    - TermMasterThes
    - Exhibitions
    - ExhibitionTitles
    - ExhObjXrefs
    - HistEvents
    - VGSRPCONDITIONSS_RO
    - vgsrpSurveyTypesS_RO
